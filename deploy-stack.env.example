# deploy-stack.sh operator config — the commented template for the untracked
# operator env file (spec: DEPLOY_ENV_SPEC.md; setup runbook:
# https://github.com/CherokeeLanguage/cherokeedictionary/wiki/deploy-stack-ssh-env-setup)
#
# Copy this file to EITHER location — the script checks both, first match wins:
#
#   ./deploy-stack.env                        (repo-local; gitignored — do NOT commit)
#   ~/.config/cherokeedictionary/deploy.env   (per-operator default)
#
# If the ~/.config location is used, start with:
#   mkdir -p ~/.config/cherokeedictionary
#
# The file is plain KEY=value shell (sourced with `set -a`). Only the
# documented keys belong here — a stray variable would shadow the script's
# internals.

# REQUIRED — the stack host's ssh target, your provisioned account there
# (the host's name itself is operator-side provisioning — not written here):
STACK_HOST=<deploy-user>@<stack-host>

# OPTIONAL overrides (the commented defaults match the script; a set value wins):
#GATE_BASE_URL=https://cherokeedictionary.net
#GATE_BOOT_TIMEOUT=180
#GATE_POLL=5
#BUILD_TIMEOUT=2700
