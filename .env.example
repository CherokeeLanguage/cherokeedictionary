# cherokeedictionary — local development environment template
# (cherokeedictionary#119 R-3)
#
# Copy to `.env` (git-ignored), fill in operator values, then load it into the
# invoking shell BEFORE invoking Gradle. The Gradle-daemon env trap (the
# AudioQualityVote#19 R-5 precedent): a forked bootRun JVM inherits the
# daemon's environment, not the invoking shell's — so either restart the
# daemon after sourcing, or run daemonless:
#
#   set -a; . ./.env; set +a
#   ./gradlew --stop && ./gradlew bootRun        # fresh daemon picks up the env
#   # or: ./gradlew --no-daemon bootRun
#
# Placeholders only — no real values here.

# Database connection (all keys required; DB_PASSWORD has no default and
# fails boot when absent — fail-closed by design):
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cherokeedictionary
DB_USER=root
DB_PASSWORD=change-me
